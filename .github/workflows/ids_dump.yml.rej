+name: IDS dump
+
+on:
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: "Git ref to run (branch/sha)"
+        required: false
+        default: "main"
+      ids_path:
+        description: "Path to _IDS.csv"
+        required: false
+        default: "tests/fixtures/tower-sim-data/_IDS.csv"
+      include_pipeline:
+        description: "Emit pipeline stage snapshots (stat inputs, computed stats, optional max-wave)"
+        required: false
+        default: "true"
+      include_run_stats:
+        description: "Compute and emit StatEngine run_stats (baseline)"
+        required: false
+        default: "true"
+      include_statbook_rows:
+        description: "Emit computed StatEngine statbook rows (filtered; can be large)"
+        required: false
+        default: "false"
+      statbook_allowlist:
+        description: "Comma-separated stat_ids for statbook rows (empty = all rows)"
+        required: false
+        default: ""
+      include_max_wave:
+        description: "Run MaxWaveEvaluator and emit result+diagnostics"
+        required: false
+        default: "false"
+      problem_spec:
+        description: "Optional path to ProblemSpec YAML/JSON (used when include_max_wave=true)"
+        required: false
+        default: ""
+  push:
+    paths:
+      - "**/_IDS.csv"
+
+permissions:
+  contents: write
+
+jobs:
+  dump-ids:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref || github.ref }}
+          fetch-depth: 0
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+          cache: "pip"
+
+      - name: Install package
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install .
+
+      - name: Dump IDS diagnostics
+        run: |
+          PYTHONPATH=. python scripts/dump_ids_diagnostics.py \
+            --ids-path "${IDS_PATH}" \
+            --output-dir audit \
+            $([ "${INCLUDE_PIPELINE}" = "true" ] && echo "--include-pipeline") \
+            $([ "${INCLUDE_RUN_STATS}" = "true" ] && echo "--include-run-stats") \
+            $([ "${INCLUDE_STATBOOK_ROWS}" = "true" ] && echo "--include-statbook-rows") \
+            $([ -n "${STATBOOK_ALLOWLIST}" ] && echo "--statbook-allowlist ${STATBOOK_ALLOWLIST}") \
+            $([ "${INCLUDE_MAX_WAVE}" = "true" ] && echo "--include-max-wave") \
+            $([ -n "${PROBLEM_SPEC}" ] && echo "--problem-spec ${PROBLEM_SPEC}")
+          cp audit/account_snapshot.json audit/ids_dump_latest.json
+          cp audit/base_stats.json audit/base_stats_latest.json
+          cp audit/inventory.json audit/inventory_latest.json
+          cp audit/loadout.json audit/loadout_latest.json
+          echo "Wrote audit/ids_dump_latest.json"
+        env:
+          IDS_PATH: ${{ inputs.ids_path || 'tests/fixtures/tower-sim-data/_IDS.csv' }}
+          INCLUDE_PIPELINE: ${{ inputs.include_pipeline || 'true' }}
+          INCLUDE_RUN_STATS: ${{ inputs.include_run_stats || 'true' }}
+          INCLUDE_STATBOOK_ROWS: ${{ inputs.include_statbook_rows || 'false' }}
+          STATBOOK_ALLOWLIST: ${{ inputs.statbook_allowlist || '' }}
+          INCLUDE_MAX_WAVE: ${{ inputs.include_max_wave || 'false' }}
+          PROBLEM_SPEC: ${{ inputs.problem_spec || '' }}
+
+      - name: Upload IDS dump artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ids-dump
+          path: |
+            audit/ids_dump_latest.json
+            audit/base_stats_latest.json
+            audit/inventory_latest.json
+            audit/loadout_latest.json
+          if-no-files-found: error
+
+      - name: Publish latest IDS dump artifacts branch
+        run: |
+          set -euo pipefail
+          tmp_dir="$(mktemp -d)"
+          cp audit/ids_dump_latest.json "$tmp_dir/ids_dump_latest.json"
+          cp audit/base_stats_latest.json "$tmp_dir/base_stats_latest.json"
+          cp audit/inventory_latest.json "$tmp_dir/inventory_latest.json"
+          cp audit/loadout_latest.json "$tmp_dir/loadout_latest.json"
+          git config user.name "github-actions"
+          git config user.email "github-actions@github.com"
+          git checkout --orphan ids-dump-latest
+          git rm -rf .
+          mkdir -p audit
+          cp "$tmp_dir/ids_dump_latest.json" audit/ids_dump_latest.json
+          cp "$tmp_dir/base_stats_latest.json" audit/base_stats_latest.json
+          cp "$tmp_dir/inventory_latest.json" audit/inventory_latest.json
+          cp "$tmp_dir/loadout_latest.json" audit/loadout_latest.json
+          git add audit/ids_dump_latest.json
+          git add audit/base_stats_latest.json
+          git add audit/inventory_latest.json
+          git add audit/loadout_latest.json
+          git commit -m "Update latest IDS dump artifacts"
+          git push --force origin ids-dump-latest
