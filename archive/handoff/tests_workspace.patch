+        preset_name='Farming',
+        state_mode='start_of_run',
+        runtime_branch_id='branch_base',
+        scenario_runtime_inputs=scenario_inputs,
+    )
+    binding_b = bind_state_identity(
+        state_b,
+        preset_name='Farming',
+        state_mode='start_of_run',
+        runtime_branch_id='branch_base',
+        scenario_runtime_inputs=scenario_inputs,
+    )
+
+    assert binding_a.identity.as_tuple() == binding_b.identity.as_tuple()
+
