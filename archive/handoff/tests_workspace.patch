+    def _fake_fallback(rows):
+        seen['fallback_calls'] += 1
+        return StatBook(
+            rows={
+                'mechanic_param::uw.black_hole.cooldown_seconds': StatRow(
+                    stat_name='mechanic_param::uw.black_hole.cooldown_seconds',
