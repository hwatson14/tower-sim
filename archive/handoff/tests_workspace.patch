+def _median_ms(fn, iterations: int = 11) -> float:
+    samples = []
+    for _ in range(iterations):
+        start = perf_counter()
+        fn()
+        samples.append((perf_counter() - start) * 1000.0)
+    return statistics.median(samples)
+
