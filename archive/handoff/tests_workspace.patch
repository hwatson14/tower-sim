+            'active_perk_preset': 'ProjectedMax_AllAllowedExceptBanned',
+        },
+    )
+
+    assert state.perk_preset_namespace_class == 'transient'
+    assert active_perk_selections(state, None) == [('PERK_ORBS_1', 2)]
