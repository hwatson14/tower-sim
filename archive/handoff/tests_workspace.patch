+def test_enemy_table_lookup_interpolates_sparse_rows():
+    engine = BossWaveEngine()
+    table = {
+        10: {'Tier 12': 100.0},
+        20: {'Tier 12': 200.0},
+    }
+    assert engine._lookup_wave_value(table, 15, 'Tier 12') == 150.0
