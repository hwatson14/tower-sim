+                contributor_id='module.galaxy_compressor.substat',
+                provenance='test.module.substat',
+                destination_object_type='canonical_stat',
+                destination_id='package_chance_pct',
+                kb_mapped=True,
+                notes='module_generator_substat',
+            ),
