+def test_all_standard_multiplier_perks_use_full_result_spb_rule():
+    import csv
+    entity_path = ROOT / 'kb' / 'perks' / 'tables' / 'perk-entity-registry.csv'
+    effect_path = ROOT / 'kb' / 'perks' / 'tables' / 'perk-effect-registry.csv'
