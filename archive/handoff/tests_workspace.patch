+    # 2 stacks: reduction = 0.40 * 1.25 = 0.50, residual = 0.50
+    # 3 stacks: reduction = 0.60 * 1.25 = 0.75, residual = 0.25
+    w0 = _ideal_wave(10, 0, 13, 0.25, steps)
