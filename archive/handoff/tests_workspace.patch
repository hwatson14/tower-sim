+    changed_fp = IncrementalCacheFingerprintBuilder().build(
+        stat_inputs=base_inputs,
+        state_mode='start_of_run',
+        preset_name='Farming',
+        card_preset_name=None,
+        module_preset_name=None,
+        perk_preset_name=None,
