+
+    timing_config = ScenarioConfig(mode_id='farming', tier=14)
+    _, timing_rows = compile_timing_family_rows(
+        account_state=state,
+        family_id='timing_farm_with_perks',
+        preset_name='Farming',
+        scenario_config=timing_config,
+        perks_enabled=True,
