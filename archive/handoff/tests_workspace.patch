+    )
+    cached_reference = bridge.recompute(
+        ProgressionRecalcRequest(
+            account_state=state,
+            preset_name='Farming',
+            workshop_levels_current={'Enemy Attack Level Skip': original_level},
+            recompute_mode='full_safe',
+        )
