+                kb_mapped=True,
+                notes='module_generator_unique_effect:kb_module_unique_routed',
+            ),
+            StatInput(
+                stat_name='Recovery Package Chance',
+                source_family='module_substat',
+                source_name='Galaxy Compressor',
+                value=5,
+                value_type='integer_pct',
